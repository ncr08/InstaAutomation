# Canonical list of the secrets the pipeline needs. This file is the single
# source of truth for their names: the setup wizard (scripts/setup-wizard.sh)
# stores each one as a GitHub Actions secret, the workflow passes them to the
# pipeline as environment variables of the same name, and the adapters read
# them from there. Run the wizard to fill them in; it can also write a local,
# gitignored .env for manual smoke tests.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the owner; messages from anyone else are ignored
TELEGRAM_OWNER_ID=
# HikerAPI access key (sent as the x-access-key header)
HIKERAPI_KEY=
# Groq API key, for Whisper transcription
GROQ_API_KEY=
# DeepSeek API key, for summarization
DEEPSEEK_API_KEY=
